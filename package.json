{
  "xo": {
    "rules": {
      "unicorn/prefer-code-point": "off",
      "unicorn/prefer-node-protocol": "off"
    },
    "prettier": true
  },
  "bugs": {
    "url": "https://github.com/alexandroit/stackline-vfile/issues"
  },
  "main": "index.js",
  "name": "@stackline/vfile",
  "type": "module",
  "types": "index.d.ts",
  "author": {
    "url": "https://wooorm.com",
    "name": "Titus Wormer",
    "email": "tituswormer@gmail.com"
  },
  "browser": {
    "./lib/minurl.js": "./lib/minurl.browser.js",
    "./lib/minpath.js": "./lib/minpath.browser.js",
    "./lib/minproc.js": "./lib/minproc.browser.js"
  },
  "funding": {
    "url": "https://opencollective.com/unified",
    "type": "opencollective"
  },
  "license": "MIT",
  "scripts": {
    "test:upstream": "node --conditions development test.js",
    "test": "npm run test:upstream",
    "build": "node scripts/check-payload.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:types": "tsc --ignoreConfig --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --strict test/stackline-types.mts"
  },
  "homepage": "https://alexandro.net/docs/vanilla/vfile/",
  "keywords": [
    "stackline",
    "npm-package",
    "vfile",
    "typescript",
    "virtual",
    "file",
    "text",
    "processing",
    "message",
    "warning",
    "error",
    "remark",
    "retext",
    "rehype",
    "maintenance-fork"
  ],
  "prettier": {
    "semi": false,
    "useTabs": false,
    "tabWidth": 2,
    "singleQuote": true,
    "trailingComma": "none",
    "bracketSpacing": false
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/stackline-vfile.git"
  },
  "description": "Virtual file format for text processing",
  "directories": {},
  "sideEffects": false,
  "contributors": [
    {
      "url": "https://wooorm.com",
      "name": "Titus Wormer",
      "email": "tituswormer@gmail.com"
    },
    {
      "name": "Brendan Abbott",
      "email": "brendan.abbott@temando.com"
    },
    {
      "name": "Denys Dovhan",
      "email": "email@denysdovhan.com"
    },
    {
      "name": "Kyle Mathews",
      "email": "mathews.kyle@gmail.com"
    },
    {
      "name": "Shinnosuke Watanabe",
      "email": "snnskwtnb@gmail.com"
    },
    {
      "name": "Sindre Sorhus",
      "email": "sindresorhus@gmail.com"
    }
  ],
  "dependencies": {
    "is-buffer": "^2.0.0",
    "@types/unist": "^2.0.0",
    "vfile-message": "^3.0.0",
    "unist-util-stringify-position": "^3.0.0"
  },
  "react-native": {
    "./lib/minurl.js": "./lib/minurl.browser.js",
    "./lib/minpath.js": "./lib/minpath.browser.js",
    "./lib/minproc.js": "./lib/minproc.browser.js"
  },
  "remarkConfig": {
    "plugins": [
      "preset-wooorm",
      [
        "lint-no-html",
        false
      ]
    ]
  },
  "typeCoverage": {
    "#": "needed `any`s",
    "detail": true,
    "strict": true,
    "atLeast": 100,
    "ignoreCatch": true,
    "ignoreFiles": [
      "lib/minurl.shared.d.ts"
    ]
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "24.12.2"
  },
  "version": "1.0.2",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.d.ts",
    "index.js",
    "lib/index.d.ts",
    "lib/index.js",
    "lib/minpath.browser.d.ts",
    "lib/minpath.browser.js",
    "lib/minpath.d.ts",
    "lib/minpath.js",
    "lib/minproc.browser.d.ts",
    "lib/minproc.browser.js",
    "lib/minproc.d.ts",
    "lib/minproc.js",
    "lib/minurl.browser.d.ts",
    "lib/minurl.browser.js",
    "lib/minurl.d.ts",
    "lib/minurl.js",
    "lib/minurl.shared.d.ts",
    "lib/minurl.shared.js",
    "license",
    "readme.md",
    "UPSTREAM.md",
    "NOTICE",
    "CHANGELOG.md"
  ]
}
